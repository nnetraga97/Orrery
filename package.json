{
  "name": "orrery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "node tools/clean-dist.mjs && vite build",
    "preview": "vite preview",
    "check": "node tools/check-boundaries.mjs && node tools/run-checks.mjs",
    "bake": "node tools/bake-dataset.mjs",
    "assets": "node tools/assets/build-assets.mjs",
    "smoke": "node tools/smoke-flat.mjs",
    "postinstall": "node tools/copy-runtime.mjs",
    "test:core": "node --experimental-strip-types --test \"src/core/**/*.test.ts\"",
    "smoke:xr": "node tools/smoke-page.mjs --page=index.html",
    "verify": "npm run typecheck && npm run check && npm run test:core && npm run build && npm run smoke && npm run smoke:xr"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@iwsdk/core": "1.1.0-rc.2",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "d3": "^7.9.2",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.2",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@iwsdk/cli": "1.1.0-rc.2",
    "@iwsdk/reference": "1.1.0-rc.2",
    "@iwsdk/vite-plugin-dev": "1.1.0-rc.2",
    "@meta-quest/metavr": "^1.8.1",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.185.0",
    "ignore": "^7.0.14",
    "playwright": "^1.65.0",
    "sharp": "0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
